{
  "entities": {
    "knowledge": {
      "title": "Knowledge",
      "description": "Jainism and Science Q&A",
      "type": "object",
      "properties": {
        "question": { "type": "object", "description": "Question in Hindi and English" },
        "jainReason": { "type": "object", "description": "Jain reason in Hindi and English" },
        "scienceReason": { "type": "object", "description": "Science reason in Hindi and English" },
        "category": { "type": "string" }
      },
      "required": ["question", "jainReason", "scienceReason"]
    },
    "tirthankar": {
      "title": "Tirthankar",
      "description": "Tirthankar details",
      "type": "object",
      "properties": {
        "name": { "type": "object" },
        "kaal": { "type": "string", "enum": ["Past", "Present", "Future"] },
        "details": { "type": "object" },
        "symbol": { "type": "object" },
        "color": { "type": "string" },
        "kalyanaks": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["name", "kaal", "details", "symbol"]
    },
    "aagam": {
      "title": "Aagam",
      "description": "Jin Vani scriptures",
      "type": "object",
      "properties": {
        "category": { "type": "string", "enum": ["Pujan", "Stuti", "Vidhan", "Chalisa", "Bhajan", "Aarti"] },
        "title": { "type": "string" },
        "content": { "type": "string" }
      },
      "required": ["category", "title", "content"]
    },
    "history": {
      "title": "History",
      "description": "Jain History",
      "type": "object",
      "properties": {
        "title": { "type": "object" },
        "content": { "type": "object" },
        "image": { "type": "string" }
      },
      "required": ["title", "content"]
    },
    "festival": {
      "title": "Festival",
      "description": "Jain Festivals",
      "type": "object",
      "properties": {
        "name": { "type": "object" },
        "date": { "type": "string" },
        "description": { "type": "object" },
        "tithi": { "type": "string" }
      },
      "required": ["name", "date", "description"]
    },
    "user": {
      "title": "User",
      "description": "User profile and roles",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user", "teacher", "student"] }
      },
      "required": ["email", "role"]
    },
    "class": {
      "title": "Class",
      "description": "Virtual Pathshala Class",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "subject": { "type": "string" },
        "title": { "type": "string" },
        "link": { "type": "string" },
        "isLive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherId", "teacherName", "subject", "title", "link"]
    },
    "exam": {
      "title": "Exam",
      "description": "Pathshala Exam",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "title": { "type": "string" },
        "duration": { "type": "number" },
        "questions": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "question": { "type": "string" },
              "options": { "type": "array", "items": { "type": "string" } },
              "correctAnswer": { "type": "number" }
            }
          } 
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherId", "teacherName", "title", "duration"]
    },
    "exam_submission": {
      "title": "Exam Submission",
      "description": "Student's exam result",
      "type": "object",
      "properties": {
        "examId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["examId", "studentId", "score"]
    },
    "settings": {
      "title": "Settings",
      "description": "Application Feature Flags",
      "type": "object",
      "properties": {
        "quizEnabled": { "type": "boolean" },
        "mediaEnabled": { "type": "boolean" }
      }
    },
    "user_chats": {
      "title": "User Chats",
      "description": "User private chats with Jainism GPT",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "messages": { "type": "array", "items": { "type": "object" } },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "title"]
    },
    "homeworks": {
      "title": "Homeworks",
      "description": "Homework assignments in Pathshala",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "description", "teacherId", "teacherName"]
    },
    "homework_submissions": {
      "title": "Homework Submissions",
      "description": "Submissions for assigned homeworks",
      "type": "object",
      "properties": {
        "homeworkId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "link": { "type": "string" },
        "submittedAt": { "type": "string" }
      },
      "required": ["homeworkId", "studentId", "studentName", "link"]
    },
    "kitchen": {
      "title": "Kitchen",
      "description": "Pure Jain kitchen profile or restaurant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "object", "description": "Name in Hindi/English" },
        "type": { "type": "string", "enum": ["family", "dharamshala", "restaurant"] },
        "address": { "type": "object" },
        "city": { "type": "string" },
        "contact": { "type": "string" },
        "sunsetCompliant": { "type": "boolean" },
        "filteredWater": { "type": "boolean" },
        "noRootsAllowed": { "type": "boolean" },
        "rating": { "type": "number" },
        "pureUtensils": { "type": "boolean" },
        "distanceSimulated": { "type": "number" },
        "aharTimings": { "type": "object" },
        "specialty": { "type": "object" },
        "reviews": { "type": "array", "items": { "type": "object" } },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "state": { "type": "string" },
        "costType": { "type": "string", "enum": ["free", "nominal", "paid"] },
        "costRupees": { "type": "number" },
        "costInfo": { "type": "object" },
        "status": { "type": "string", "enum": ["approved", "pending"] },
        "chatHistory": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["name", "type", "address", "city", "contact", "status"]
    },
    "dharamshala": {
      "title": "Dharamshala",
      "description": "Verified Jain Dharamshala details and live room state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "object" },
        "tirth": { "type": "object" },
        "sect": { "type": "string", "enum": ["Digambar", "Svetambar", "Unified"] },
        "distanceToHillWalk": { "type": "string" },
        "roomsAvailable": { "type": "number" },
        "totalRooms": { "type": "number" },
        "pricePerDay": { "type": "number" },
        "rating": { "type": "number" },
        "aharshalaStatus": { "type": "object" },
        "contact": { "type": "string" },
        "address": { "type": "object" },
        "facilities": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "required": ["id", "name", "tirth", "sect", "roomsAvailable", "totalRooms", "pricePerDay", "contact", "address"]
    },
    "dharamshala_booking": {
      "title": "Dharamshala Booking",
      "description": "Live booking request and approval state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dharamshalaId": { "type": "string" },
        "dharamshalaName": { "type": "object" },
        "tirth": { "type": "object" },
        "pilgrimName": { "type": "string" },
        "checkInDate": { "type": "string" },
        "roomType": { "type": "string" },
        "guestsCount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "priceCollected": { "type": "number" },
        "contact": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "dharamshalaId", "pilgrimName", "checkInDate", "roomType", "status"]
    },
    "jain_news": {
      "title": "Jain News",
      "description": "Verified Jain news articles",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "impact": { "type": "string" },
        "source": { "type": "string" },
        "url": { "type": "string" },
        "isVerified": { "type": "boolean" }
      },
      "required": ["title", "summary", "category", "date"]
    },
    "jain_store": {
      "title": "Jain Store Profile",
      "description": "Jain vendor mini store profiles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vendorName": { "type": "string" },
        "storeName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "logoUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "vendorName", "storeName", "email", "status"]
    },
    "jain_product": {
      "title": "Jain Store Product",
      "description": "Products listed under a Jain store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeId": { "type": "string" },
        "storeName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "contactNo": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "storeId", "storeName", "title", "price", "category", "status"]
    }
  },
  "firestore": {
    "/knowledge/{id}": { "schema": "knowledge", "description": "Knowledge items" },
    "/tirthankars/{id}": { "schema": "tirthankar", "description": "Tirthankar data" },
    "/aagams/{id}": { "schema": "aagam", "description": "Aagam data" },
    "/history/{id}": { "schema": "history", "description": "History data" },
    "/festivals/{id}": { "schema": "festival", "description": "Festival data" },
    "/users/{uid}": { "schema": "user", "description": "User profiles" },
    "/classes/{id}": { "schema": "class", "description": "Pathshala classes" },
    "/exams/{id}": { "schema": "exam", "description": "Pathshala exams" },
    "/exam_submissions/{id}": { "schema": "exam_submission", "description": "Exam results" },
    "/settings/config": { "schema": "settings", "description": "Global app settings" },
    "/user_chats/{id}": { "schema": "user_chats", "description": "Private user chat sessions" },
    "/homeworks/{id}": { "schema": "homeworks", "description": "Pathshala homework records" },
    "/homework_submissions/{id}": { "schema": "homework_submissions", "description": "Homework student answers" },
    "/kitchens/{id}": { "schema": "kitchen", "description": "Verified Jain kitchens and registrations" },
    "/dharamshalas/{id}": { "schema": "dharamshala", "description": "Dharamshala properties" },
    "/dharamshala_bookings/{id}": { "schema": "dharamshala_booking", "description": "Bookings table for notifications and approvals" },
    "/jain_news/{id}": { "schema": "jain_news", "description": "Verified news updates" },
    "/jain_stores/{id}": { "schema": "jain_store", "description": "Vendor stores" },
    "/jain_products/{id}": { "schema": "jain_product", "description": "Vendor items" }
  }
}
